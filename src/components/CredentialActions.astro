---
import type { Credential } from '../data/certificates';
import { localUrl } from '../data/urls';
const { credential:c } = Astro.props as {credential:Credential};
---
<div class="credential-actions">
  {c.verify && <a href={c.verify} target="_blank" rel="noopener noreferrer">Verify credential ↗<span class="sr-only">: {c.title}</span></a>}
  {c.image && <button class="preview-button" data-image={localUrl(c.image)} data-title={c.title}>Preview certificate<span class="sr-only">: {c.title}</span></button>}
</div>
